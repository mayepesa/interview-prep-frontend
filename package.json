{
  "name": "interview-prep-frontend",
  "version": "1.0.0",
  "description": "Repaso práctico para entrevistas de front end: React, JavaScript, TypeScript, CSS, testing, performance y fundamentos de CS.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "typecheck": "tsc",
    "test": "vitest run --project concepts",
    "test:watch": "vitest --project concepts",
    "practice": "vitest --project practice",
    "check:solutions": "SOLUTIONS=1 vitest run --project practice",
    "format": "prettier --write .",
    "check": "npm run typecheck && npm test && npm run check:solutions"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  }
}
